{
	"name": "nhl-stats-advanced-client",
	"version": "0.0.1",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"test": "npm run test:integration",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:integration": "playwright test --config=playwright.smoke.config.ts"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-vercel": "^7.0.5",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/eslint": "8.56.0",
		"@typescript-eslint/eslint-plugin": "^8.74.0",
		"@typescript-eslint/parser": "^8.74.0",
		"autoprefixer": "^10.4.16",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"postcss": "^8.5.33",
		"postcss-load-config": "^5.0.2",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.5.9",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^3.3.6",
		"tslib": "^2.4.1",
		"typescript": "^6.0.0",
		"vite": "^8.3.8"
	},
	"type": "module",
	"dependencies": {
		"@vercel/analytics": "^1.1.1",
		"clsx": "^2.0.0",
		"tailwind-merge": "^2.2.0"
	},
	"overrides": {
		"@vercel/analytics": {
			"@sveltejs/kit": "$@sveltejs/kit"
		}
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
